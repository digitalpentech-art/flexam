# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-super-secret-key-change-me

# Database Configuration
# Format: postgresql://username:password@localhost:5432/dbname
DEV_DATABASE_URL=postgresql://postgres:password@localhost:5432/flexam_dev
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/flexam_test
DATABASE_URL=postgresql://postgres:password@localhost:5432/flexam_prod

# Redis (if needed later)
REDIS_URL=redis://localhost:6379/0
